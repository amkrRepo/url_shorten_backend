# Environment for `npm run test:e2e` only.
# Loaded by the `dotenv -e .env.test` wrapper in the package.json test
# scripts. `npm start` / `start:dev` keep reading .env (Neon) untouched,
# because dotenv never overrides variables that are already set.
DATABASE_URL=postgresql://postgres@localhost:5432/url_shortener_test
BASE_URL=http://localhost:3000
