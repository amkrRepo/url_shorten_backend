# Environment for `npm run test:e2e` and the k6 load tests
# (`npm run start:loadtest` + `npm run test:load:cache`).
# Loaded by the `dotenv -e .env.test` wrapper in the package.json test
# scripts. `npm start` / `start:dev` keep reading .env (Neon) untouched,
# because dotenv never overrides variables that are already set.
DATABASE_URL=postgresql://postgres@localhost:5432/url_shortener_test
BASE_URL=http://localhost:3100
# Port for the server started by `npm run start:loadtest`. Kept off 3000 so
# the load test never hits a `start:dev` server running on the real DB.
PORT=3100
