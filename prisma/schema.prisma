generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model urls {
  id               Int       @id @default(autoincrement())
  original_url     String
  short_code       String    @unique @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  visit_count      Int       @default(0)
  last_accessed_at DateTime? @db.Timestamp(6)
  user_id          Int?
  deleted_at       Boolean?
  expiry_date      DateTime? @db.Date
  user             users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_urls_foreign_key")

  @@index([created_at], map: "idx_created_at")
}

model users {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String    @db.VarChar(255)
  api_key    String    @unique @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  urls       urls[]
}
