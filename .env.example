# Sentry error/performance reporting. Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
# Fraction of requests traced (0 to 1). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to false to bypass the in-memory redirect cache (for benchmarking).
REDIRECT_CACHE_ENABLED=true
# Seconds a browser may reuse a redirect without hitting the server. Defaults to 300.
BROWSER_CACHE_MAX_AGE_SECONDS=300
