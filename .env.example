# Sentry error/performance reporting. Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
# Fraction of requests traced (0 to 1). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Redis connection for the redirect cache. Start it with `podman-compose up -d redis`.
REDIS_URL=redis://localhost:6379
# Set to false to bypass the Redis redirect cache (for benchmarking).
REDIRECT_CACHE_ENABLED=true
# Longest a redirect stays cached, in seconds. Expiring links are dropped
# sooner, when they expire. Defaults to 86400 (24 hours).
REDIRECT_CACHE_TTL_SECONDS=86400
# Seconds a browser may reuse a redirect without hitting the server. Defaults to 300.
BROWSER_CACHE_MAX_AGE_SECONDS=300
